{
  "name": "arahbaik",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run build && wrangler dev",
    "dev:web": "vite --host 0.0.0.0",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "deploy": "npm run check && wrangler deploy",
    "deploy:check": "npm run build && wrangler deploy --dry-run"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router-dom": "7.18.4",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.10",
    "@types/node": "24.9.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "wrangler": "4.151.3"
  }
}
